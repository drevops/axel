{
    "name": "@drevops/axel",
    "version": "0.3.1",
    "description": "Turns clicks and form interactions on elements marked with data-axel-* attributes into analytics events.",
    "license": "MIT",
    "author": {
        "name": "Alex Skrypnyk",
        "email": "alex@drevops.com",
        "url": "https://drevops.com"
    },
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/drevops/axel.git"
    },
    "homepage": "https://github.com/drevops/axel#readme",
    "bugs": "https://github.com/drevops/axel/issues",
    "type": "module",
    "main": "dist/axel.esm.js",
    "module": "dist/axel.esm.js",
    "exports": {
        ".": "./dist/axel.esm.js",
        "./dist/*": "./dist/*"
    },
    "jsdelivr": "dist/axel.gtm.min.js",
    "unpkg": "dist/axel.gtm.min.js",
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "directories": {
        "test": "tests"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "lint": "eslint . && prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
        "lint-fix": "eslint --fix . && prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
        "pretest": "npm run build",
        "test": "vitest run",
        "pretest-coverage": "npm run build",
        "test-coverage": "vitest run --coverage",
        "pretest-functional": "npm run build",
        "test-functional": "playwright test",
        "reset": "rm -Rf node_modules dist .logs"
    },
    "engines": {
        "npm": ">=10.9.10",
        "node": ">=22.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@vitest/coverage-v8": "^5.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "fast-check": "^4.10.2",
        "globals": "^17.14.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.10",
        "vitest": "^5.1.0"
    },
    "prettier": {
        "singleQuote": true,
        "printWidth": 160
    }
}
